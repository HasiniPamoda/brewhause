# Copy this file to .env and fill in the values. Never commit .env.
PORT=4000

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Frontend address(es) allowed to call this API, comma-separated, no trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# Where the SQLite file lives (optional)
DB_PATH=./data/brewhaus.db
